    - id: main
      label: Graphics
      sections:
      - title: Resolution & anti-aliasing
        bindingColumns: 0
        settings:
        - key: graphics.renderScale
          label: Render scale
          kind: 4
          info: Resolution of the 3D image relative to the screen. Menus and text always stay sharp.
          optionSource: 0
          options: []
          ordinal: 0
          min: 50
          max: 200
          step: 5
          decimals: 0
          unit: '%'
          defaultValue: 100
          muteKey: 
          audioChannel: 
          actionName: 
          bindingGroup: 
          locked: 0
          applies: 0
          preview: 4
          gpuCost: 5
          visualGain: 4
          disabledWhen: []
        - key: graphics.upscaling
          label: Upscaling
          kind: 0
          info: How the 3D image is enlarged when Render scale is below 100%. STP gives the cleanest result; FSR is lighter.
          optionSource: 0
          options:
          - Bilinear
          - FSR 1.0
          - STP
          ordinal: 0
          min: 0
          max: 100
          step: 1
          decimals: 0
          unit: 
          defaultValue: 1
          muteKey: 
          audioChannel: 
          actionName: 
          bindingGroup: 
          locked: 0
          applies: 0
          preview: 4
          gpuCost: 1
          visualGain: 3
          disabledWhen:
          - key: graphics.renderScale
            op: 3
            value: 100
            reason: Only used when Render scale is below 100%.
        - key: graphics.antiAliasing
          label: Anti-aliasing
          kind: 0
          info: Smooths jagged edges. SMAA is sharp and cheap, TAA is smoothest in motion, MSAA is the most accurate on geometry.
          optionSource: 0
          options:
          - Off
          - FXAA
          - SMAA
          - TAA
          - "MSAA 2\xD7"
          - "MSAA 4\xD7"
          ordinal: 0
          min: 0
          max: 100
          step: 1
          decimals: 0
          unit: 
          defaultValue: 2
          muteKey: 
          audioChannel: 
          actionName: 
          bindingGroup: 
          locked: 0
          applies: 0
          preview: 4
          gpuCost: 3
          visualGain: 4
          disabledWhen: []
      - title: Textures
        bindingColumns: 0
        settings:
        - key: graphics.textureQuality
          label: Texture quality
          kind: 0
          info: Resolution of surfaces and liveries. Lower settings use less video memory.
          optionSource: 0
          options:
          - Quarter
          - Half
          - Full
          ordinal: 1
          min: 0
          max: 100
          step: 1
          decimals: 0
          unit: 
